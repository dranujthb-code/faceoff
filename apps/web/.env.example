# ───────────────────────── FaceOff environment template ─────────────────────────
# Copy to .env.local for development. Never commit real secrets.
# Variables prefixed NEXT_PUBLIC_ are exposed to browsers — never put secrets in them.

APP_ENV=development                  # development | staging | production
APP_URL=http://localhost:3000        # canonical public URL (used in emails, OG tags, share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL 15+; Supabase, Neon, RDS or local)
# DATABASE_URL: the runtime login role. It must be a member of anon, authenticated and service_role.
#   On Supabase use the transaction pooler (port 6543) with the `postgres` user.
DATABASE_URL=postgres://faceoff_api:faceoff_api_dev_password@127.0.0.1:54322/faceoff_dev
# DATABASE_ADMIN_URL: owner/superuser used only by migrations and seeds.
DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:54322/faceoff_dev
DB_CREATE_APP_ROLE=true              # local only: create the DATABASE_URL login role during migration
DATABASE_POOL_MAX=10

# Auth
AUTH_COOKIE_NAME=fo_session
SESSION_TTL_DAYS=30

# Email: "dev" captures messages in the database (view at /dev/mailbox); "resend" sends for real.
EMAIL_DRIVER=dev
RESEND_API_KEY=
EMAIL_FROM="FaceOff <hello@example.com>"

# File storage for avatars (and replay links): "local" writes to ./.data/uploads; "s3" uses any
# S3-compatible store (Supabase Storage S3 endpoint, AWS S3, Cloudflare R2).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Live video — LiveKit (Cloud or self-hosted). Leave blank to run without video:
# the debate room will clearly state that video is not configured.
LIVEKIT_URL=                         # e.g. wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Room-composite recording via LiveKit Egress to the S3 bucket above.
LIVEKIT_EGRESS_ENABLED=false

# Scheduled sweeper (Vercel Cron calls /api/cron/sweep with this bearer token)
CRON_SECRET=change-me-in-every-environment

# Seed (development/staging only)
SEED_ADMIN_EMAIL=admin@faceoff.local
SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026
SEED_DEMO_CONTENT=true
