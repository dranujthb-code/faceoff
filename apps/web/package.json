{
  "name": "@faceoff/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts"
  },
  "dependencies": {
    "@faceoff/shared": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@livekit/components-react": "2.9.15",
    "aws4fetch": "1.0.20",
    "clsx": "2.1.1",
    "livekit-client": "2.15.14",
    "livekit-server-sdk": "2.14.0",
    "lucide-react": "0.545.0",
    "next": "16.3.8",
    "postgres": "3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.34.4",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "dotenv": "17.2.3",
    "eslint": "9.38.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
